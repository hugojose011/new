@echo off
setlocal EnableExtensions
rem Instalador local completo - Squad Funil Black de Ofertas
rem Grava os arquivos do squad nesta pasta e instala Python/Playwright/Chromium.

set "DIR=%~dp0"
cd /d "%DIR%"

echo ----------------------------------------------------------
echo  Squad Funil Black de Ofertas - instalacao local
echo ----------------------------------------------------------
echo.
echo Pasta de destino:
echo   %DIR%
echo.
echo 1. Gravando README.md ...
if exist "%TEMP%\ifl_1.b64" del "%TEMP%\ifl_1.b64" >nul 2>&1
>>"%TEMP%\ifl_1.b64" echo 
>>"%TEMP%\ifl_1.b64" echo 
>>"%TEMP%\ifl_1.b64" echo 
>>"%TEMP%\ifl_1.b64" echo 
>>"%TEMP%\ifl_1.b64" echo 
>>"%TEMP%\ifl_1.b64" echo IHNlbXByZSBzYWkgcGlvciBxdWUgbyB0ZW1wbGF0ZSB0ZXN0YWRvLgo=
powershell -NoProfile -Command "[IO.File]::WriteAllBytes('%DIR%README.md', [Convert]::FromBase64String(((Get-Content '%TEMP%\ifl_1.b64' -Raw) -replace '\s','')))"
if errorlevel 1 (echo    FALHOU ao gravar README.md.) else (echo    ok)
del "%TEMP%\ifl_1.b64" >nul 2>&1

echo 2. Gravando CLAUDE.md ...
if exist "%TEMP%\ifl_2.b64" del "%TEMP%\ifl_2.b64" >nul 2>&1
>>"%TEMP%\ifl_2.b64" echo 
>>"%TEMP%\ifl_2.b64" echo 
>>"%TEMP%\ifl_2.b64" echo 
>>"%TEMP%\ifl_2.b64" echo 
>>"%TEMP%\ifl_2.b64" echo 
powershell -NoProfile -Command "[IO.File]::WriteAllBytes('%DIR%CLAUDE.md', [Convert]::FromBase64String(((Get-Content '%TEMP%\ifl_2.b64' -Raw) -replace '\s','')))"
if errorlevel 1 (echo    FALHOU ao gravar CLAUDE.md.) else (echo    ok)
del "%TEMP%\ifl_2.b64" >nul 2>&1

echo 3. Gravando INSTALAR-WINDOWS.bat ...
if exist "%TEMP%\ifl_3.b64" del "%TEMP%\ifl_3.b64" >nul 2>&1
>>"%TEMP%\ifl_3.b64" echo 
>>"%TEMP%\ifl_3.b64" echo 
powershell -NoProfile -Command "[IO.File]::WriteAllBytes('%DIR%INSTALAR-WINDOWS.bat', [Convert]::FromBase64String(((Get-Content '%TEMP%\ifl_3.b64' -Raw) -replace '\s','')))"
if errorlevel 1 (echo    FALHOU ao gravar INSTALAR-WINDOWS.bat.) else (echo    ok)
del "%TEMP%\ifl_3.b64" >nul 2>&1

echo 4. Gravando INSTALAR-MAC.command ...
if exist "%TEMP%\ifl_4.b64" del "%TEMP%\ifl_4.b64" >nul 2>&1
>>"%TEMP%\ifl_4.b64" echo 
>>"%TEMP%\ifl_4.b64" echo 
powershell -NoProfile -Command "[IO.File]::WriteAllBytes('%DIR%INSTALAR-MAC.command', [Convert]::FromBase64String(((Get-Content '%TEMP%\ifl_4.b64' -Raw) -replace '\s','')))"
if errorlevel 1 (echo    FALHOU ao gravar INSTALAR-MAC.command.) else (echo    ok)
del "%TEMP%\ifl_4.b64" >nul 2>&1

echo ----------------------------------------------------------
echo Arquivos gravados. Iniciando a instalacao das dependencias.
echo ----------------------------------------------------------
echo.
if exist "%DIR%INSTALAR-WINDOWS.bat" (
    call "%DIR%INSTALAR-WINDOWS.bat"
) else (
    echo Nao encontrei o INSTALAR-WINDOWS.bat. Algo falhou na gravacao acima.
    echo.
    echo Pressione qualquer tecla para fechar...
    pause >nul
)
exit /b 0
