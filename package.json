{
  "name": "agenda-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm --filter @agenda/database build && pnpm --filter @agenda/shared build && pnpm --filter @agenda/api build && pnpm --filter @agenda/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @agenda/web test:e2e",
    "db:generate": "pnpm --filter @agenda/database generate",
    "db:migrate": "pnpm --filter @agenda/database migrate",
    "db:deploy": "pnpm --filter @agenda/database deploy",
    "db:seed": "pnpm --filter @agenda/database seed",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "typescript": "5.7.3"
  }
}
