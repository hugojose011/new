# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agenda?schema=public

# ---------------------------------------------------------------------------
# URLs da aplicação
# ---------------------------------------------------------------------------
# URL pública do frontend (usada em links de cancelamento/reagendamento)
WEB_URL=http://localhost:3000
# URL pública da API
API_URL=http://localhost:3333
# Porta em que a API sobe
PORT=3333
NODE_ENV=development

# ---------------------------------------------------------------------------
# Segurança
# ---------------------------------------------------------------------------
# Segredo usado para assinar o JWT de sessão (cookie HttpOnly). >= 32 chars.
JWT_SECRET=troque-este-valor-por-um-segredo-longo-e-aleatorio
# Duração da sessão
SESSION_TTL_MINUTES=720
# Chave AES-256-GCM em base64 (32 bytes). Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Identificador da chave ativa (permite rotação futura: v1, v2, ...)
ENCRYPTION_KEY_ID=v1
# Chaves antigas ainda aceitas para decriptar, formato: id:base64,id:base64
ENCRYPTION_KEYS_LEGACY=

# ---------------------------------------------------------------------------
# Google OAuth / Calendar
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3333/integrations/google/callback

# ---------------------------------------------------------------------------
# Notificações (opcional no MVP: sem chave, usa provider de log)
# ---------------------------------------------------------------------------
# console | resend
EMAIL_PROVIDER=console
EMAIL_FROM=Agenda <no-reply@example.com>
EMAIL_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# Opcional
# ---------------------------------------------------------------------------
# Redis só é necessário se quiser cache/locks distribuídos entre instâncias.
# Sem REDIS_URL o sistema usa cache em memória (a proteção real de double
# booking é a constraint de exclusão no PostgreSQL, não o cache).
REDIS_URL=
AVAILABILITY_CACHE_TTL_SECONDS=20
