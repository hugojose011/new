{
  "name": "@agenda/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.js --runInBand",
    "test:unit": "jest --config jest.config.js --runInBand --testPathPattern \"\\.spec\\.ts$\"",
    "test:integration": "jest --config jest.config.js --runInBand --testPathPattern \"\\.int-spec\\.ts$\""
  },
  "dependencies": {
    "@agenda/database": "workspace:*",
    "@agenda/shared": "workspace:*",
    "@nestjs/common": "11.0.12",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.0.12",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/platform-express": "11.0.12",
    "@nestjs/swagger": "11.1.0",
    "@nestjs/throttler": "6.4.0",
    "@prisma/client": "6.19.3",
    "argon2": "0.41.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "google-auth-library": "9.15.1",
    "googleapis": "144.0.0",
    "helmet": "8.0.0",
    "luxon": "3.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.5",
    "@nestjs/schematics": "11.0.2",
    "@nestjs/testing": "11.0.12",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/luxon": "3.4.2",
    "@types/node": "22.13.1",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "8.23.0",
    "@typescript-eslint/parser": "8.23.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.3"
  }
}
